adingType="None" Level="0" BreakLatinWord="KeepWord" BreakNonLatinWord="true"><PARAMARGIN Indent="0" Left="0" Right="0" Prev="0" Next="0" LineSpacingType="Percent" LineSpacing="160"/></PARASHAPE><PARASHAPE Id="1" Align="Center" VerAlign="Baseline" HeadingType="None" Level="0" BreakLatinWord="KeepWord" BreakNonLatinWord="true"><PARAMARGIN Indent="0" Left="0" Right="0" Prev="0" Next="0" LineSpacingType="Percent" LineSpacing="160"/></PARASHAPE></PARASHAPELIST></MAPPINGTABLE></HEAD><BODY><SECTION Id="0"><P ParaShape="1" Style="0"><TEXT CharShape="1"><SECDEF TextDirection="0"><PAGEDEF Landscape="0" Width="59528" Height="84188" GutterType="LeftOnly"><PAGEMARGIN Left="8504" Right="8504" Top="5668" Bottom="4252" Header="4252" Footer="4252" Gutter="0"/></PAGEDEF></SECDEF><CHAR>HWPML 견본</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="0"><CHAR>한글 문서의 옛 XML 형식에는 줄을 나눈 위치가 저장되지 않으므로 글자의 폭을 재서 본문 폭 안에서 직접 줄을 나누고 문단 모양의 줄 간격대로 쌓는다. Latin words such as layout and pagination are kept whole and wrap at spaces, while Hangul may break between any two characters.</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="0"><CHAR>첫 줄</CHAR><CHAR><LINEBREAK/></CHAR><CHAR>줄바꿈 뒤</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="0"><TABLE PageBreak="Cell" RowCount="3" ColCount="2" BorderFill="1"><SHAPEOBJECT TextWrap="TopAndBottom"><SIZE Width="42520" Height="4400"/><POSITION TreatAsChar="true" VertRelTo="Para" HorzRelTo="Column" VertAlign="Top" HorzAlign="Left" VertOffset="0" HorzOffset="0"/></SHAPEOBJECT><INSIDEMARGIN Left="510" Right="510" Top="141" Bottom="141"/><ROW><CELL ColAddr="0" RowAddr="0" ColSpan="1" RowSpan="1" Width="10000" Height="2000" HasMargin="false" BorderFill="1"><PARALIST TextDirection="0" LineWrap="Break" VertAlign="Center"><P ParaShape="0" Style="0"><TEXT CharShape="0"><CHAR>항목</CHAR></TEXT></P></PARALIST></CELL><CELL ColAddr="1" RowAddr="0" ColSpan="1" RowSpan="1" Width="32520" Height="2000" HasMargin="false" BorderFill="1"><PARALIST TextDi